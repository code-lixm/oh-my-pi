    "./index.css": "./src/index.css"
  },
  "bin": {
    "omp-web": "server/cli.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.server.json",
    "serve": "bun server/cli.ts",
    "prestart": "bun run build",
    "start": "bun server/cli.ts",
    "test": "bun run test:unit",
    "test:unit": "bun test --conditions=browser --preload ./happydom.ts ./src",
    "test:unit:watch": "bun test --conditions=browser --watch --preload ./happydom.ts ./src"
  },
