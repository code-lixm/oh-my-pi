{
  "name": "@oh-my-pi/pi-web",
  "version": "1.18.18-omp.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./desktop-menu": "./src/desktop-menu.ts",
    "./contract": "./shared/omp-web-contract.ts",
    "./i18n/desktop-native": "./src/i18n/desktop-native.ts",
    "./i18n/english": "./shared/omp-i18n-english.ts",
    "./updater": "./src/updater.ts",
