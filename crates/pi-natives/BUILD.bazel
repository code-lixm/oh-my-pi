    ],
    hdrs = glob(["src/codegraph/grammars/scala/tree_sitter/*.h"]),
    defines = ["tree_sitter_scala=codegraph_tree_sitter_scala"] + [
        "tree_sitter_scala_external_scanner_{0}=codegraph_tree_sitter_scala_external_scanner_{0}".format(suffix)
        for suffix in _SCANNER_SUFFIXES
    ],
    includes = ["src/codegraph/grammars/scala"],
    alwayslink = True,
)

cc_library(
    name = "codegraph_grammar_dart",
    srcs = [
        "src/codegraph/grammars/dart/parser.c",
        "src/codegraph/grammars/dart/scanner.c",
    ],
    hdrs = glob(["src/codegraph/grammars/dart/tree_sitter/*.h"]),
