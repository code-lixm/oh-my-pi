load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_shared_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

_SCANNER_SUFFIXES = ["create", "destroy", "scan", "serialize", "deserialize"]

cc_library(
    name = "codegraph_grammar_kotlin",
    srcs = [
        "src/codegraph/grammars/kotlin/parser.c",
        "src/codegraph/grammars/kotlin/scanner.c",
    ],
    hdrs = glob(["src/codegraph/grammars/kotlin/tree_sitter/*.h"]),
    defines = ["tree_sitter_kotlin=codegraph_tree_sitter_kotlin"] + [
        "tree_sitter_kotlin_external_scanner_{0}=codegraph_tree_sitter_kotlin_external_scanner_{0}".format(suffix)
        for suffix in _SCANNER_SUFFIXES
    ],
    includes = ["src/codegraph/grammars/kotlin"],
    alwayslink = True,
)

cc_library(
    name = "codegraph_grammar_lua",
    srcs = [
        "src/codegraph/grammars/lua/parser.c",
        "src/codegraph/grammars/lua/scanner.c",
    ],
    hdrs = glob(["src/codegraph/grammars/lua/tree_sitter/*.h"]),
    defines = ["tree_sitter_lua=codegraph_tree_sitter_lua"] + [
        "tree_sitter_lua_external_scanner_{0}=codegraph_tree_sitter_lua_external_scanner_{0}".format(suffix)
        for suffix in _SCANNER_SUFFIXES
    ],
    includes = ["src/codegraph/grammars/lua"],
    alwayslink = True,
